# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example je šablóna bez tajomstiev a patrí do repa —
# bez nej nikto nevie, ktoré premenné treba doplniť.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --------------------------------------------------------------------------
# Predávaný obsah sa NIKDY necommituje.
# Repo je verejný — skutočné GPX a roadbooky by si ktokoľvek stiahol zadarmo
# priamo z GitHubu a platený produkt by stratil zmysel.
# Do gitu smú len ukážkové súbory s predponou example-.
# --------------------------------------------------------------------------
content/gpx/*
!content/gpx/example-*
