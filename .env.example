# Skopíruj na .env.local a doplň skutočné hodnoty.
# .env* je v .gitignore — kľúče sa nikdy nedostanú do gitu.

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# TWINT NEMÁ vlastný API kľúč a nie je to samostatná integrácia.
# Zapína sa v Stripe Dashboarde: Settings → Payment methods → TWINT.
# Potom sa v Checkoute objaví sám vedľa karty.
#
# Testovacie kľúče začínajú sk_test_ / pk_test_, ostré sk_live_ / pk_live_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Podpis webhooku. Získa sa pri vytvorení endpointu v Stripe Dashboarde,
# alebo lokálne cez `stripe listen --forward-to localhost:3000/api/webhook`.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Doručenie trasy
# ---------------------------------------------------------------------------
# Tajný kľúč na podpisovanie odkazov na stiahnutie GPX.
# Vygeneruj čokoľvek dlhé a náhodné, napr.: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=

# Odosielanie e-mailov s trasou
RESEND_API_KEY=
MAIL_FROM="SML Moto <trasy@example.ch>"

# ---------------------------------------------------------------------------
# Ostatné
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Náhľad pre klienta na subdoméne ADM: SITE_ENV=staging.
# Pridá noindex — meta tag aj hlavičku (web sa nedostane do Google) a pruh „toto nie je
# ostrý web". Na ostrom webe nechať prázdne. Číta sa pri builde — po zmene
# treba nasadiť znova.
SITE_ENV=

# ---------------------------------------------------------------------------
# Bezplatný plánovač trás (vrstva Bronze)
# ---------------------------------------------------------------------------
# Kľúč z openrouteservice.org — bezplatná registrácia, 2000 dopytov denne.
# Bez neho plánovač vo vývoji použije demo server OSRM (len na testovanie),
# v produkcii vráti 503 a rozhranie oznámi, že nie je nastavený.
OPENROUTESERVICE_KEY=

# ---------------------------------------------------------------------------
# Databáza (Neon) — trasy a administrácia
# ---------------------------------------------------------------------------
# Neon → projekt → Connect → Connection string, voľba „Pooled connection".
# Tvar: postgresql://<používateľ>:<heslo>@<server>-pooler.<región>.aws.neon.tech/<databáza>?sslmode=require
# Plné práva — LEN na serveri, nikdy s predponou NEXT_PUBLIC_.
# Bez nej web lokálne číta data/routes.json; na ostrom webe build zlyhá
# (zámerne — tichý návrat k JSON by predával podľa starých cien).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Úložisko súborov trás (Cloudflare R2) — bucket route-files, SÚKROMNÝ
# ---------------------------------------------------------------------------
# Account ID je v Cloudflare → R2 vpravo. Kľúče: R2 → Manage API tokens →
# Create token, oprávnenie „Object Read & Write", len pre bucket route-files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Len na jednorazový presun zo Supabase (npm run db:presun). Po presune zmazať.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Prihlásenie do /admin. Oba riadky vyrobí `npm run admin:heslo`.
# Heslo samotné sa nikam neukladá, len jeho scrypt hash. Kľúč musí mať
# aspoň 32 znakov, inak administrácia nikoho nepustí.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
